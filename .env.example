# Backend API Configuration
REACT_APP_API_URL=http://localhost:5001/api
FLASK_PORT=5001
FLASK_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLASK_DEBUG=True

# Gemini API Configuration (image generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# AWS Bedrock (chapter analysis via Claude). Use any standard credential source.
AWS_REGION=eu-central-1

# Supabase (W2). Leave blank to fall back to the local frontend/public mirror.
# SUPABASE_URL is the project URL, e.g. https://abcd1234.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the *service_role* key — never ship to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
